        "step_role": "any"
      },
      "effect": {
        "type": "drop"
      },
      "evidence": "screens and links on the primary path",
      "priority": 2,
      "source": {
        "type": "heuristic",
        "note": "From the persona's inference_rule text"
      },
      "tests": {
        "positive": "tests/tired_pm/funnel.too_many_clicks.pos.md",
        "negative": "tests/tired_pm/funnel.too_many_clicks.neg.md"
      },
      "reaction": "Click 4. I'm already late for standup."
    },
    {
      "id": "funnel.too_many_fields",
      "category": "funnel",
      "measurement": "form_fields",
      "comparison": ">",
      "threshold": 2,
      "scope": {
        "type": "step",
        "step_role": "any"
      },
      "effect": {
        "type": "drop"
      },
      "evidence": "form component on the step",
      "priority": 2,
      "source": {
